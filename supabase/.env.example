# Valores que `config.toml` toma del entorno con `env(...)`.
#
# El CLI lee este directorio automáticamente: copiá esto a `supabase/.env` y
# listo. No tiene secretos, por eso la plantilla se commitea.

# La base con la que Auth arma los links de mails y valida los redirects.
#
# Difiere por entorno y por eso no está fija en config.toml: local es tu
# máquina, producción es el dominio de Vercel.
#
#   OJO: si esta variable NO está definida, el CLI no interpola nada y manda el
#   string literal "env(SUPABASE_AUTH_SITE_URL)". Un `config push` distraído
#   dejaría producción con ese texto como site_url. Por eso: SIEMPRE
#   `supabase config diff` antes de `supabase config push`, y mirá que el
#   valor local sea una URL de verdad.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000
