# Para local. Las mismas cinco variables, pero con los valores y los cuidados
# del deploy, están en `.env.production.example`. Si agregás una acá, va allá.

# --- Supabase -----------------------------------------------------------------
# Project settings -> API. The service role key bypasses RLS: server only, never
# prefixed NEXT_PUBLIC_, never imported into a Client Component.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ---------------------------------------------------------------------
# Shared secret guarding /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site ---------------------------------------------------------------------
# Absolute base URL, used by the sitemap. On Vercel this is filled in
# automatically from the project's production domain if left empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No hay envío de mails: el consultorio todavía no tiene dominio propio, así que
# no hay confirmaciones ni recordatorios por correo. El link para cancelar se le
# muestra al paciente en pantalla al terminar de reservar.
