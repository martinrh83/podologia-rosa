# --- Supabase -----------------------------------------------------------------
# Project settings -> API. The service role key bypasses RLS: server only, never
# prefixed NEXT_PUBLIC_, never imported into a Client Component.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) -----------------------------------------------------------
# EMAIL_FROM must be on a domain verified in Resend, otherwise confirmations
# land in spam and the cancel link never gets clicked.
RESEND_API_KEY=
EMAIL_FROM=turnos@example.com
ADMIN_EMAIL=

# --- Cron ---------------------------------------------------------------------
# Shared secret guarding /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site ---------------------------------------------------------------------
# Absolute base URL used to build cancel links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
